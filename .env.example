NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only; never expose to the browser
SUPABASE_SERVICE_ROLE_KEY=
# Feature flags: default OFF; set to "true" to enable (server-side)
FEATURE_CLINICAL=
FEATURE_LIVE_PAYMENTS=
FEATURE_EMERGENCY_DISPATCH=
FEATURE_PHARMACY=
FEATURE_SUBSCRIPTIONS=
FEATURE_GPS=
FEATURE_AUTOMATED_PAYOUTS=
FEATURE_PAY_AFTER=
FEATURE_NOTIFY_SMS=false
FEATURE_NOTIFY_EMAIL=false
FEATURE_NOTIFY_WHATSAPP=false
NOTIFY_SMS_ADAPTER=log
NOTIFY_EMAIL_ADAPTER=log
NOTIFY_WHATSAPP_ADAPTER=log
# Own HTTPS origin; authenticated locale dashboards must exist before activation.
APP_ORIGIN=
# Server-only dispatcher authentication. Set in deployment secrets, never code.
CRON_SECRET=
